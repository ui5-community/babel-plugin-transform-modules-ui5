{
  "name": "babel-plugin-transform-modules-ui5",
  "version": "7.11.1",
  "description": "An unofficial babel plugin for SAP UI5.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ui5-community/babel-plugin-transform-modules-ui5.git",
    "directory": "packages/plugin"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "babel src -d dist",
    "build:watch": "babel src -d dist --watch",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "lint:staged": "lint-staged",
    "test": "NODE_OPTIONS=--experimental-vm-modules FORCE_COLOR=0 jest __test__ --coverage=no",
    "test:watch": "npm test -- --watch",
    "test:update-snapshot": "NODE_OPTIONS=--experimental-vm-modules FORCE_COLOR=0 jest --updateSnapshot",
    "format": "prettier --write 'src/**/*.js'"
  },
  "keywords": [
    "ui5",
    "sap",
    "sapui5",
    "openui5",
    "babel",
    "babel8",
    "babeljs",
    "babel-plugin",
    "babelplugin",
    "es6",
    "module",
    "import",
    "export",
    "typescript",
    "ts"
  ],
  "author": "Ryan Murphy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/r-murphy/babel-plugin-transform-modules-ui5/issues"
  },
  "homepage": "https://github.com/r-murphy/babel-plugin-transform-modules-ui5#readme",
  "jest": {
    "collectCoverage": true,
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "excludeJestPreset": true
        }
      ]
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "comment-parser": "1.4.7"
  },
  "peerDependencies": {
    "@babel/core": "^8"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/eslint-parser": "8.1.2",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-syntax-decorators": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/plugin-transform-typescript": "8.1.3",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-flow": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "babel-jest": "30.5.2",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "16.2.7",
    "prettier": "3.9.0",
    "rimraf": "6.1.3"
  }
}
